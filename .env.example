# ── Site ─────────────────────────────────────────────────────────────────────
SITE_NAME=Voa Leve
SITE_URL=http://localhost:3000
CONTACT_EMAIL=contato@voaleve.com.br
TELEGRAM_PUBLIC_URL=https://t.me/voaleve
# Hosts permitidos como destino dos links rastreados (/go/:id), separados por vírgula.
# Se vazio: google.com/travel, aviasales, travelpayouts e kiwi.
# ALLOWED_AFFILIATE_HOSTS=www.aviasales.com,www.kiwi.com

# ── Admin ────────────────────────────────────────────────────────────────────
# Troque em produção. Sem ADMIN_PASSWORD o login fica desabilitado em produção.
ADMIN_PASSWORD=admin123
# Segredo usado para cookie de sessão e tokens de confirmação/descadastro.
# Obrigatório em produção; o valor padrão abaixo funciona apenas em dev.
AUTH_SECRET=change-me-to-a-long-random-secret

# ── Banco ────────────────────────────────────────────────────────────────────
# Sem DATABASE_URL, usa PGlite no diretório de dados do usuário
# (Windows: %LOCALAPPDATA%\voa-leve\pglite).
# DATABASE_URL é obrigatório em produção (PGlite é single-process).
# DATABASE_URL=postgres://user:password@host:5432/database
# PGLITE_DATA_DIR=C:\caminho\fora\do\OneDrive\pglite
# Liberar PGlite em modo produção apenas para teste local:
# ALLOW_PGLITE_IN_PRODUCTION=1

# ── Fonte de preços ──────────────────────────────────────────────────────────
# mock = demonstração determinística; travelpayouts = API real.
PRICE_SOURCE=mock
MIN_PRICE_CENTS=8000
DETECTION_VERSION=1

# Travelpayouts (necessário para PRICE_SOURCE=travelpayouts)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com

# ── E-mail transacional ──────────────────────────────────────────────────────
# Sem RESEND_API_KEY, os envios são simulados no log do worker.
RESEND_API_KEY=
EMAIL_FROM="Voa Leve <alertas@voaleve.com.br>"

# ── Telegram ─────────────────────────────────────────────────────────────────
# Sem token/channel, o worker não enfileira broadcast no Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
