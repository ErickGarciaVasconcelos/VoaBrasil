{
  "name": "ppa",
  "version": "0.1.0",
  "private": true,
  "description": "Voa Leve — alertas de passagens aéreas baratas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "worker": "tsx apps/worker/src/index.ts",
    "worker:dev": "tsx watch apps/worker/src/index.ts",
    "db:generate": "npm run generate --workspace @ppa/db",
    "db:migrate": "npm run migrate --workspace @ppa/db",
    "demo": "npm run demo --workspace apps/worker",
    "images:fetch": "tsx apps/web/scripts/fetch-destination-images.ts",
    "test": "npm run test --workspace @ppa/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
